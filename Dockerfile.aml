FROM python:3.11-slim

WORKDIR /app
COPY tools/ /app/tools/

RUN useradd --create-home --shell /usr/sbin/nologin aml \
    && mkdir -p /data/vault \
    && chown -R aml:aml /data /app

ENV HOST=0.0.0.0 \
    PORT=8000 \
    CV_VAULT_DIR=/data/vault \
    PYTHONUNBUFFERED=1

USER aml
VOLUME ["/data/vault"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import os, urllib.request; p=os.environ.get('PORT') or '8000'; urllib.request.urlopen(f'http://127.0.0.1:{p}/health', timeout=2)" || exit 1

CMD ["python", "tools/aml_adapter.py", "--serve"]
